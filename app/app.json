            {
              "scheme": "file",
              "mimeType": "application/vnd.ms-word.template.macroEnabled.12"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/msword"
            },
            {
              "scheme": "file",
              "mimeType": "application/msword"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            {
              "scheme": "content",
