              "pathPattern": ".*\\\\.ott"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.docx"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.docm"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.dotx"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.dotm"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.doc"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.dot"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.rtf"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.odt"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\\\.ott"
            }
          ]
