{
  "name": "docx-reader-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "start": "expo start",
    "engine:sync": "node scripts/engine-sync.mjs",
    "licences": "node scripts/licences.mjs",
    "android": "../android-env.sh expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:plugins",
    "build:apk": "node scripts/build-release.mjs apk",
    "build:aab": "node scripts/build-release.mjs aab",
    "test:plugins": "node --test plugins/plugins.test.js plugins/source-map-packages.test.js"
  },
  "dependencies": {
    "@expo-google-fonts/arimo": "0.4.3",
    "@expo/log-box": "58.0.13",
    "@expo/metro-runtime": "58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.21",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.15",
    "expo-router": "58.0.28",
    "expo-share-intent": "9.0.0",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "lucide-react-native": "1.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.13",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "/viewer/generated/viewer-html$": "<rootDir>/src/viewer/viewer-html.stub.ts",
      "/licences/generated/licences\\.json$": "<rootDir>/src/licences/licences.stub.json"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/plugins/",
      "/android/"
    ]
  }
}
